# Alchemy WebSocket URL — use Base mainnet for best economics
ALCHEMY_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Wallet private key (0x-prefixed, 64 hex chars — NEVER commit a real key)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Chain ID: 8453=Base (recommended), 42161=Arbitrum, 11155111=Sepolia testnet
CHAIN_ID=8453

# Flash loan contract addresses (deploy ApexFlashLoan.sol to each chain)
APEX_FLASH_LOAN_BASE=0xYOUR_BASE_CONTRACT
APEX_FLASH_LOAN_ARB=0xYOUR_ARB_CONTRACT

# Supabase (optional — logging disabled when absent)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Telegram (optional — alerts disabled when absent)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Set to "true" for dry-run mode (no live trades)
DRY_RUN=true

# NODE_ENV controls which .env file loads: "production" → .env.mainnet, else .env.testnet
NODE_ENV=development
