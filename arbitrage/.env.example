# Go arbitrage bot — copy to .env and fill in values
# All vars are prefixed ARB_ and read automatically

# Required
ARB_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ARB_RPC_URLS=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY,https://mainnet.base.org
ARB_FLASH_LOAN_CONTRACT=0xYOUR_DEPLOYED_CONTRACT_ADDRESS

# Profit threshold ($5 default — lower = more trades, more gas risk)
ARB_MIN_PROFIT_USDC=5000000

# Gas gate — skip execution if Base base fee exceeds this (gwei)
ARB_MAX_GAS_GWEI=5.0

# Set false to go live
ARB_DRY_RUN=true

# Supabase logging (optional — dashboard won't show Go bot data without this)
ARB_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
ARB_SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Telegram alerts (optional — get notified on every profitable trade)
ARB_TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
ARB_TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# Timing
ARB_SCAN_INTERVAL=500ms
ARB_LOG_LEVEL=info
