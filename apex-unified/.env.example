# ── Identity ──────────────────────────────────────────────────────────────────
BOT_ID=apex-unified
STRATEGY_ID=apex.dex_spread
RUN_ID=                             # auto-generated if blank

# ── Safety (defaults to maximum safety — must explicitly unlock) ───────────────
DRY_RUN=true
ALLOW_LIVE=false

# ── Network ────────────────────────────────────────────────────────────────────
NETWORK=base
CHAIN_ID=8453
ALCHEMY_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Strategy feature flags ─────────────────────────────────────────────────────
ENABLE_DEX_SPREAD_SIGNAL=true
ENABLE_TRIANGULAR_SIGNAL=true
ENABLE_CBETH_SIGNAL=true
ENABLE_CEX_CONTEXT=true
ENABLE_FLASH_LOAN_PLANNER=true
ENABLE_BUILDER_SUBMISSION=false     # false until live execution

# ── Risk limits ────────────────────────────────────────────────────────────────
MAX_TRADE_USD=50000
MAX_DAILY_LOSS_USD=500
MAX_PER_TRADE_LOSS_USD=100
MIN_NET_EDGE_BPS=5
CEX_TRIGGER_BPS=15

# ── Infrastructure ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Live execution (leave blank during dry run) ────────────────────────────────
# PRIVATE_KEY=0x...
# APEX_FLASH_LOAN_BASE=0x...
