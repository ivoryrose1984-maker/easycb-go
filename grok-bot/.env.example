# Grok Bot — copy to .env and fill in values
# DRY_RUN and ALLOW_LIVE default to safe values — never change for dry-run

# Required
ALCHEMY_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Safety — do not change during dry-run
DRY_RUN=true
ALLOW_LIVE=false

# Identity (auto-generated RUN_ID if omitted)
BOT_ID=grok-bot
STRATEGY_ID=cbeth_fair_value_base

# Thresholds
MIN_NET_EDGE_BPS=5
CEX_TRIGGER_BPS=15

# Supabase (optional)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Telegram (optional)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
